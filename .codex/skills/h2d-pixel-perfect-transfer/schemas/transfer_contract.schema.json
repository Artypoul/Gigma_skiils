{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "H2D immutable transfer contract",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "workspace_root", "source", "decoder", "decoded_artifacts", "responsive_matrix", "browser_profiles", "candidate", "classification", "reference_bundle", "sidecars", "approvals", "current_commands", "expected_reports"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "workspace_root": {"type": "string", "minLength": 1},
    "source": {"$ref": "#/$defs/hashedPath"},
    "decoder": {"$ref": "#/$defs/hashedPath"},
    "decoded_artifacts": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/hashedPath"}},
    "responsive_matrix": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["width", "height", "kind"], "properties": {"width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}, "kind": {"enum": ["decoded", "breakpoint-boundary", "interval-probe"]}}, "additionalProperties": true}
    },
    "browser_profiles": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["id", "headless", "device_scale_factor", "is_mobile", "has_touch", "locale", "timezone", "reduced_motion"], "properties": {"id": {"type": "string", "minLength": 1}, "headless": {"type": "boolean"}, "device_scale_factor": {"type": "number", "exclusiveMinimum": 0}, "is_mobile": {"type": "boolean"}, "has_touch": {"type": "boolean"}, "locale": {"type": "string"}, "timezone": {"type": "string"}, "reduced_motion": {"enum": ["reduce", "no-preference"]}}, "additionalProperties": true}
    },
    "candidate": {"type": "object", "required": ["project_root", "include", "closure_sha256", "mode"], "properties": {"project_root": {"type": "string", "minLength": 1}, "include": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "closure_sha256": {"$ref": "#/$defs/sha256"}, "mode": {"enum": ["entry", "managed-url"]}}, "additionalProperties": true},
    "classification": {"type": "object", "required": ["behavior_required", "liveness_required", "coverage_complete"], "properties": {"behavior_required": {"type": "boolean"}, "liveness_required": {"type": "boolean"}, "coverage_complete": {"const": true}}, "additionalProperties": true},
    "reference_bundle": {"$ref": "#/$defs/hashedPath"},
    "sidecars": {"type": "array", "items": {"$ref": "#/$defs/hashedPath"}},
    "approvals": {"type": "array", "items": {"type": "object"}},
    "current_commands": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}},
    "expected_reports": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "hashedPath": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}, "additionalProperties": true}
  }
}
