{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Atomic H2D reference bundle",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "result", "coverage_complete", "source_sha256", "donor_identity", "donor_closure", "environment_by_profile", "matrix_keys", "classification", "visual", "dynamic", "artifacts"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "result": {"const": "pass"},
    "coverage_complete": {"const": true},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "donor_identity": {"type": "string", "minLength": 1},
    "donor_closure": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["path", "sha256", "size"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "size": {"type": "integer", "minimum": 0}}, "additionalProperties": false}},
    "environment_by_profile": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "matrix_keys": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "classification": {"type": "object", "required": ["result", "coverage_complete", "generator_sha256", "source_sha256", "donor_identity", "donor_closure", "matrix_keys", "breakpoints", "behavior_required", "liveness_required"], "properties": {"generator_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "donor_closure": {"type": "array", "minItems": 1}, "breakpoints": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 1}}}, "additionalProperties": true},
    "visual": {"type": "object", "required": ["donor_identity"], "properties": {"donor_identity": {"type": "string"}}, "additionalProperties": true},
    "dynamic": {"type": "object", "required": ["donor_identity"], "properties": {"donor_identity": {"type": ["string", "null"]}}, "additionalProperties": true},
    "artifacts": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": true}}
  }
}
