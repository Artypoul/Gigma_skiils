{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "token_reuse",
  "description": "Candidate-side proof that every significant donor color is mapped to one pinned token definition and is consumed through a shared usage instead of scattered literals.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "result": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "no-donor-palette",
        "not-tested"
      ]
    },
    "generator_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "token_map_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "min_donor_count": {
      "type": "integer"
    },
    "max_scatter": {
      "type": "integer"
    },
    "sources_scanned": {
      "type": "integer"
    },
    "token_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "color",
          "result"
        ],
        "additionalProperties": true
      }
    },
    "issues": {
      "type": "array"
    }
  },
  "required": [
    "result",
    "generator_sha256",
    "token_map_sha256",
    "min_donor_count",
    "max_scatter",
    "sources_scanned",
    "token_files",
    "checks",
    "issues"
  ]
}
