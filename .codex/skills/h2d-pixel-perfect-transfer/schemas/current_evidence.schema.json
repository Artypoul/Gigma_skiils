{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Current H2D transfer evidence",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "result", "contract_path", "contract_sha256", "runner_sha256", "candidate_digest_before", "candidate_digest_after", "matrix_completed", "reports"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "result": {"const": "pass"},
    "contract_path": {"type": "string", "minLength": 1},
    "contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runner_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_digest_before": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_digest_after": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "matrix_completed": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "reports": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": true}}
  }
}
