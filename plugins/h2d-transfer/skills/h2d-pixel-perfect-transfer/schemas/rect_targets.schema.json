{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "rect_targets",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "scope": {
      "type": "string"
    },
    "coordinate_space": {
      "type": "string",
      "enum": [
        "page",
        "branch-local",
        "component-local"
      ]
    },
    "viewport_key_format": {
      "type": "string"
    },
    "coverage_mode": {"enum": ["complete-ancestor-chain", "scope-only"]},
    "includes_ancestors": {"type": "boolean"},
    "root_map": {"type": "object", "additionalProperties": {"type": "string"}},
    "source_tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "generator_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "viewports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "viewport",
          "root_path",
          "targets"
          ,"target_count"
          ,"ancestor_target_count"
          ,"layout_target_count"
        ],
        "properties": {
          "viewport": {
            "type": "integer"
          },
          "root_path": {
            "type": "string"
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "key",
                "data_h2d_path",
                "rect"
                ,"parent_path"
                ,"relation_to_scope"
              ],
              "properties": {
                "key": {
                  "type": "string"
                },
                "data_h2d_path": {
                  "type": "string"
                },
                "type": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "tag": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "rect": {
                  "type": "object",
                  "required": [
                    "x",
                    "y",
                    "width",
                    "height"
                  ],
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    },
                    "width": {
                      "type": "number"
                    },
                    "height": {
                      "type": "number"
                    }
                  },
                  "additionalProperties": true
                },
                "parent_path": {"type": ["string", "null"]},
                "relation_to_scope": {"enum": ["scope-ancestor", "scope-root", "scope-descendant"]},
                "text_style": {
                  "description": "Donor typography in CSS camelCase, compared straight against getComputedStyle on the candidate. Metric props fail the gate; fontFamily is reported as a substitution.",
                  "type": "object",
                  "additionalProperties": {
                    "type": [
                      "string",
                      "number"
                    ]
                  }
                },
                "rendered_font": {
                  "description": "Font the donor's browser actually used. A brand family declared but rendered as a system face proves a fallback, e.g. missing script coverage.",
                  "type": "object",
                  "properties": {
                    "family": {
                      "type": "string"
                    },
                    "post_script_name": {
                      "type": "string"
                    },
                    "declared": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": true
                },
                "box_style": {
                  "description": "Container constraints (maxWidth, padding, gap, margin) that the candidate must reproduce structurally instead of compensating for.",
                  "type": "object",
                  "additionalProperties": {
                    "type": [
                      "string",
                      "number"
                    ]
                  }
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    },
    "total_targets": {
      "type": "integer"
    }
  },
  "required": [
    "scope",
    "coordinate_space",
    "coverage_mode",
    "includes_ancestors",
    "root_map",
    "source_tree_sha256",
    "generator_sha256",
    "viewports",
    "total_targets"
  ]
}
