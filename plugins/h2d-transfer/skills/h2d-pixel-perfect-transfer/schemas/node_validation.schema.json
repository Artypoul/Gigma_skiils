{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "node_validation",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "result": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "partial",
        "manual-review"
      ]
    },
    "generator_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "threshold_px": {
      "type": "number"
    },
    "viewports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "viewport",
          "result"
        ],
        "properties": {
          "viewport": {
            "type": "integer"
          },
          "result": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "partial"
            ]
          },
          "checked": {
            "type": "integer"
          },
          "missing": {
            "type": "array"
          },
          "extra": {
            "type": "array"
          },
          "max_delta": {
            "type": "number"
          },
          "mode": {
            "description": "How candidate nodes were resolved: data-h2d-path markers, or a selector map when transferring into an existing project.",
            "type": "string",
            "enum": [
              "markers",
              "selector-map"
            ]
          },
          "style_checked": {
            "type": "integer"
          },
          "issues": {
            "type": "array"
          },
          "warnings": {
            "type": "array"
          },
          "accepted_deviations": {
            "type": "array"
          }
        },
        "additionalProperties": true
      }
    },
    "global_max_delta": {
      "type": "number"
    },
    "style_threshold_px": {
      "type": "number"
    },
    "strict_font_family": {
      "type": "boolean"
    },
    "lenient_box_style": {
      "type": "boolean"
    },
    "selector_map_injective": {"type": "boolean"},
    "issues": {
      "type": "array"
    },
    "warnings": {
      "description": "Non-failing findings that must still be resolved in review.md, such as font substitutions. Final proof rejects lenient container checks.",
      "type": "array"
    },
    "accepted_deviations": {
      "description": "Deltas the owner approved, e.g. a heading that is taller in another language. Each entry carries the reason.",
      "type": "array"
    }
  },
  "required": [
    "result",
    "generator_sha256",
    "viewports",
    "lenient_box_style",
    "selector_map_injective"
  ]
}
